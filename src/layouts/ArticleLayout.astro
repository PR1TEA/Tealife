---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';
import { formatDate, formatDateLong } from '../utils/date';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: CollectionEntry<'articles'>;
  headings: Heading[];
}

const { article, headings } = Astro.props;
const { title, description, pubDate, updatedDate, category, series, tags, cover, coverAlt } =
  article.data;

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const updated =
  updatedDate && updatedDate.valueOf() !== pubDate.valueOf() ? updatedDate : undefined;
---

<BaseLayout title={title} description={description}>
  <article class="article">
    <div class="container container--narrow">
      <header class="article__header">
        <a class="article__back" href="/articles/">
          ← Articles
        </a>

        <div class="article__meta">
          <span>{category}</span>
          {series && <span>系列：{series}</span>}
          <time datetime={pubDate.toISOString()}>{formatDateLong(pubDate)}</time>
          {updated && <span>更新于 {formatDate(updated)}</span>}
        </div>

        <h1 class="article__title">{title}</h1>
        <p class="article__lead">{description}</p>

        {tags.length > 0 && (
          <ul class="article__tags">
            {tags.map((tag) => (
              <li>
                <span>#{tag}</span>
              </li>
            ))}
          </ul>
        )}
      </header>

      {cover && (
        <figure class="article__cover">
          <Image
            src={cover}
            alt={coverAlt ?? title}
            widths={[640, 960, 1280]}
            sizes="(min-width: 42rem) 42rem, 100vw"
          />
        </figure>
      )}

      {toc.length >= 2 && (
        <nav class="article__toc" aria-labelledby="toc-title">
          <h2 id="toc-title" class="article__toc-title">
            目录
          </h2>
          <ol>
            {toc.map((heading) => (
              <li class:list={{ 'article__toc-sub': heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: clamp(3rem, 7vw, 5rem) var(--space-8);
  }

  .article__header {
    margin-block-end: var(--space-7);
  }

  .article__back {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .article__back:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-block-start: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .article__title {
    margin-block-start: var(--space-3);
    font-size: var(--text-3xl);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .article__lead {
    margin-block-start: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .article__tags span {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .article__cover {
    margin: 0 0 var(--space-7);
  }

  .article__cover :global(img) {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .article__toc {
    margin-block-end: var(--space-7);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .article__toc-title {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .article__toc ol {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .article__toc li + li {
    margin-block-start: var(--space-1);
  }

  .article__toc a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .article__toc a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .article__toc-sub {
    padding-inline-start: var(--space-4);
  }
</style>
