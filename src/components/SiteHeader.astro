---
import favicon from '../../images/decorative/icons/favicon.svg?url';
import { SECTIONS, SITE } from '../config/site';

const pathname = Astro.url.pathname;

interface Props {
  /** 浮在深色满版背景上时使用 */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

function isActive(href: string): boolean {
  return pathname === href || pathname.startsWith(href);
}
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <img class="brand__icon" src={favicon} alt="" width="24" height="24" aria-hidden="true" />
      <span>{SITE.name}</span>
    </a>

    <nav class="nav" aria-label="主要导览">
      <ul>
        {SECTIONS.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 1px solid var(--color-border);
  }

  .site-header--overlay {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 20;
    border-block-end-color: var(--color-border);
  }

  .site-header--overlay .brand {
    color: var(--color-text);
  }

  .site-header--overlay .nav a {
    color: var(--color-text);
  }

  .site-header--overlay .nav a:hover,
  .site-header--overlay .nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand__icon {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    filter: invert(1);
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    text-decoration-color: currentColor;
  }

  @media (max-width: 42rem) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      padding-block: var(--space-3);
    }

    .nav {
      order: 3;
      width: 100%;
    }

    .nav ul {
      justify-content: space-between;
      gap: var(--space-2);
    }

    .nav a {
      padding-block: var(--space-2);
    }
  }
</style>
