---
/**
 * 深色 / 淺色模式切換。
 * 初始主題由 BaseLayout 的 inline script 在首次繪製前設定。
 */
interface Props {
  /** 放在深色背景上時使用白色樣式 */
  inverse?: boolean;
}

const { inverse = false } = Astro.props;
---

<button
  class:list={['theme-toggle', { 'theme-toggle--inverse': inverse }]}
  type="button"
  data-theme-toggle
  aria-label="切換深色模式"
>
  <svg
    class="icon icon--sun"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.8v2.1M12 19.1v2.1M4.5 4.5l1.5 1.5M18 18l1.5 1.5M2.8 12h2.1M19.1 12h2.1M4.5 19.5L6 18M18 6l1.5-1.5"></path>
  </svg>
  <svg
    class="icon icon--moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a6.8 6.8 0 0 0 10.8 10.8Z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const storageKey = 'theme';
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function syncLabel(): void {
    const isDark = root.dataset.theme === 'dark';
    buttons.forEach((button) => {
      button.setAttribute('aria-label', isDark ? '切換為淺色模式' : '切換為深色模式');
    });
  }

  syncLabel();

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem(storageKey, next);
      } catch {
        /* 無法寫入時僅影響下次造訪 */
      }
      syncLabel();
    });
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background-color: transparent;
    color: var(--color-text-muted);
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .theme-toggle--inverse {
    border-color: rgb(255 255 255 / 0.35);
    color: #fff;
  }

  .theme-toggle--inverse:hover {
    border-color: #fff;
    color: #fff;
  }

  .theme-toggle .icon {
    width: 1rem;
    height: 1rem;
  }
</style>
