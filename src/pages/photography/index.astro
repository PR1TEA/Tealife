---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '/images/photography/*.{avif,AVIF,jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP}',
  { eager: true },
);

const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, module], index) => {
    const isLarge = index % 7 === 0;
    const isWide = !isLarge && index % 5 === 0;

    return {
      src: module.default,
      alt: `摄影作品 ${index + 1}`,
      className: isLarge ? 'tile--large' : isWide ? 'tile--wide' : undefined,
    };
  });
---

<BaseLayout title="Photography">
  <div class="page">
    <div class="container container--wide">
      <h1 class="photography__sr-title">Photography</h1>
      <p class="photography__intro">PR1TEA的摄影集，全部由PR1TEA创作，任何时间，任何地点</p>

      {photos.length > 0 && (
        <div class="tiles">
          {photos.map((photo) => (
            <div class:list={['tile', photo.className]}>
              <Image src={photo.src} alt={photo.alt} width={640} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .photography__sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .photography__intro {
    max-width: 42rem;
    font-size: var(--text-lg);
  }

  .tiles {
    --tile: clamp(7.5rem, 20vw, 9.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--tile));
    grid-auto-rows: var(--tile);
    grid-auto-flow: dense;
    gap: 0.5rem;
    margin-block-start: var(--space-6);
  }

  .tile {
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
  }

  .tile--wide {
    grid-column: span 2;
  }

  .tile--large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration) var(--ease);
  }

  @media (hover: hover) {
    .tile:hover :global(img) {
      transform: scale(1.03);
    }
  }
</style>
