---
import { getCollection } from 'astro:content';
import ArticleList from '../components/ArticleList.astro';
import Calendar from '../components/Calendar.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { SECTIONS } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentArticles = articles.slice(0, 3);
---

<BaseLayout headerOverlay>
  <section class="hero">
    <h1 class="hero__title" lang="ru">
      Даже в тяжести самых крутых перемен...
    </h1>
    <span class="hero__scroll" aria-hidden="true">
      ↓
    </span>
  </section>

  <section class="home-body">
    <div class="container home-body__layout">
      <aside class="home-sidebar" aria-label="個人資料與日曆">
        <div class="home-profile">
          <ProfileCard />
        </div>
        <Calendar />
      </aside>

      <div class="home-body__main">
        <section class="home-articles" aria-labelledby="articles-title">
          <h2 id="articles-title" class="home-articles__title">
            Articles
          </h2>
          <ArticleList articles={recentArticles} />
        </section>

        <nav class="home-sections" aria-label="主要內容">
          {SECTIONS.map((section) => (
            <a class="section-link" href={section.href}>
              <span class="section-link__label">{section.label}</span>
              <span class="section-link__arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: var(--space-5);
    overflow: hidden;
    background-color: var(--color-bg);
    background-image: url('../../images/decorative/backgrounds/desktop_wallpaper.jpg');
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
    color: #fff;
    text-align: center;
  }

  @media (max-width: 56rem) and (orientation: portrait) {
    .hero {
      background-image: url('../../images/decorative/backgrounds/mobile_wallpaper.jpg');
    }
  }

  /* 暗色遮罩，確保壁紙上的文字可讀 */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 0.8);
  }

  .hero__title {
    position: relative;
    z-index: 1;
    max-width: 22ch;
    margin-inline: auto;
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }

  .hero__scroll {
    position: absolute;
    z-index: 1;
    inset-block-end: var(--space-5);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    color: rgb(255 255 255 / 0.55);
    font-size: var(--text-lg);
    line-height: 1;
  }

  .home-body {
    padding-block: clamp(4rem, 9vw, 7rem) 0;
    background-color: var(--color-bg);
    background-image:
      linear-gradient(rgb(0 0 0 / 0.8), rgb(0 0 0 / 0.8)),
      url('../../images/decorative/backgrounds/desktop_wallpaper.jpg');
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }

  .home-body__layout {
    display: grid;
    grid-template-columns: 15rem minmax(0, 42rem);
    align-items: start;
    justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .home-sidebar {
    position: sticky;
    inset-block-start: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .home-profile {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: rgb(18 18 18 / 0.82);
    -webkit-backdrop-filter: blur(18px) saturate(1.05);
    backdrop-filter: blur(18px) saturate(1.05);
  }

  .home-body__main {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: rgb(18 18 18 / 0.82);
    -webkit-backdrop-filter: blur(18px) saturate(1.05);
    backdrop-filter: blur(18px) saturate(1.05);
  }

  .home-articles {
    padding-block: 0;
  }

  .home-articles__title {
    font-size: var(--text-2xl);
  }

  .home-sections {
    margin-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }

  .section-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-border);
    text-decoration: none;
  }

  .section-link__label {
    font-size: var(--text-lg);
  }

  .section-link__arrow {
    color: var(--color-text-muted);
    transition:
      color var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .section-link:hover .section-link__arrow {
    color: var(--color-text);
    transform: translateX(0.2rem);
  }

  @media (max-width: 56rem) {
    .home-body__layout {
      grid-template-columns: 1fr;
    }

    .home-sidebar {
      position: static;
    }
  }

  @media (max-width: 56rem) and (orientation: portrait) {
    .home-body {
      background-image:
        linear-gradient(rgb(0 0 0 / 0.8), rgb(0 0 0 / 0.8)),
        url('../../images/decorative/backgrounds/mobile_wallpaper.jpg');
      background-attachment: scroll;
    }
  }
</style>
