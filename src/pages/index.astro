---
import ProfileCard from '../components/ProfileCard.astro';
import { SECTIONS, SITE } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="page">
    <div class="container container--narrow">
      <h1 class="page-title">{SITE.name}</h1>

      <div class="home__profile">
        <ProfileCard />
      </div>

      <nav class="home__sections" aria-label="主要內容">
        {SECTIONS.map((section) => (
          <a class="section-link" href={section.href}>
            <span class="section-link__label">{section.label}</span>
            <span class="section-link__arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .home__profile {
    margin-block-start: var(--space-6);
  }

  .home__sections {
    margin-block-start: var(--space-7);
    border-block-start: 1px solid var(--color-border);
  }

  .section-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-border);
    text-decoration: none;
  }

  .section-link__label {
    font-size: var(--text-lg);
  }

  .section-link__arrow {
    color: var(--color-text-muted);
    transition:
      color var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .section-link:hover .section-link__arrow {
    color: var(--color-text);
    transform: translateX(0.2rem);
  }
</style>
