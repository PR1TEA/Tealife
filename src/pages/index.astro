---
import { getCollection } from 'astro:content';
import ArticleList from '../components/ArticleList.astro';
import Calendar from '../components/Calendar.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { SECTIONS } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentArticles = articles.slice(0, 5);
const homeSections = SECTIONS.filter((section) => section.href === '/photography/');
---

<BaseLayout headerOverlay>
  <section class="hero">
    <div class="hero__content">
      <h1 class="hero__title" lang="ru">
        Даже в тяжести самых крутых перемен...
      </h1>
      <div class="hero__actions">
        <a
          class="hero__rss"
          href="/rss.xml"
          data-rss-copy
          aria-label="複製 RSS 連結"
          title="複製 RSS 連結"
        >
          <span data-rss-label>RSS</span>
        </a>
        <a
          class="hero__github"
          href="https://github.com/PR1TEA"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            />
          </svg>
          <span>GitHub</span>
        </a>
        <button
          class="hero__email"
          type="button"
          data-email-copy
          data-email="PR1TEA@icloud.com"
          aria-label="複製 PR1TEA@icloud.com"
          title="複製 PR1TEA@icloud.com"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M2 4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4Zm2-.5a.5.5 0 0 0-.5.5v.2l4.5 2.8 4.5-2.8V4a.5.5 0 0 0-.5-.5H4Zm8.5 1.9-4.2 2.6a.5.5 0 0 1-.6 0L3.5 5.4V12a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5V5.4Z"
            />
          </svg>
          <span data-email-label>PR1TEA@icloud.com</span>
        </button>
      </div>
    </div>
    <span class="hero__scroll" aria-hidden="true">
      ↓
    </span>
  </section>

  <section class="home-body">
    <div class="container home-body__layout">
      <aside class="home-sidebar" aria-label="個人資料與日曆">
        <div class="home-profile">
          <ProfileCard />
        </div>
        <Calendar />
      </aside>

      <div class="home-body__main">
        <section class="home-articles" aria-labelledby="articles-title">
          <div class="home-articles__header">
            <h2 id="articles-title" class="home-articles__title">
              Articles
            </h2>
            <a class="home-articles__more" href="/articles/" aria-label="更多文章">
              更多
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <ArticleList articles={recentArticles} />
        </section>

        <nav class="home-sections" aria-label="主要內容">
          {homeSections.map((section) => (
            <a class="section-link" href={section.href}>
              <span class="section-link__label">{section.label}</span>
              <span class="section-link__arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: var(--space-5);
    overflow: hidden;
    background-color: var(--color-bg);
    background-image: url('../../images/decorative/backgrounds/desktop_wallpaper.jpg');
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
    color: var(--color-text);
    text-align: center;
  }
  @media (max-width: 56rem) and (orientation: portrait) {
    .hero {
      height: 100svh;
      min-height: 0;

      background-image: url('../../images/decorative/backgrounds/mobile_wallpaper.jpg');
      background-attachment: scroll;
      background-size: contain;
      background-position: center;
      background-repeat: no-repeat;
    }
  }

  /* 暗色遮罩，確保壁紙上的文字可讀 */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgb(231 231 231 / 0.6);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .hero__title {
    position: relative;
    z-index: 1;
    max-width: 22ch;
    margin-inline: auto;
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .hero__rss {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .hero__rss:hover,
  .hero__rss.is-copied {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .hero__github {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .hero__github svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .hero__github:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .hero__email {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background-color: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    appearance: none;
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .hero__email svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .hero__email:hover,
  .hero__email.is-copied {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .hero__scroll {
    position: absolute;
    z-index: 1;
    inset-block-end: var(--space-5);
    inset-inline-start: 50%;
    transform: translateX(-50%);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1;
  }

  .home-body {
    padding-block: clamp(4rem, 9vw, 7rem) 0;
    background-color: var(--color-bg);
    background-image:
      linear-gradient(rgb(231 231 231 / 0.6), rgb(231 231 231 / 0.6)),
      url('../../images/decorative/backgrounds/desktop_wallpaper.jpg');
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }

  .home-body__layout {
    display: grid;
    grid-template-columns: 15rem minmax(0, 42rem);
    align-items: start;
    justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .home-sidebar {
    position: sticky;
    inset-block-start: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .home-profile {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: rgb(243 243 243 / 0.82);
    -webkit-backdrop-filter: blur(18px) saturate(1.05);
    backdrop-filter: blur(18px) saturate(1.05);
  }

  .home-body__main {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: rgb(243 243 243 / 0.82);
    -webkit-backdrop-filter: blur(18px) saturate(1.05);
    backdrop-filter: blur(18px) saturate(1.05);
  }

  .home-articles {
    padding-block: 0;
  }

  .home-articles__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .home-articles__title {
    font-size: var(--text-2xl);
  }

  .home-articles__more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .home-articles__more:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .home-sections {
    margin-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-border);
  }

  .section-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--color-border);
    text-decoration: none;
  }

  .section-link__label {
    font-size: var(--text-lg);
  }

  .section-link__arrow {
    color: var(--color-text-muted);
    transition:
      color var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .section-link:hover .section-link__arrow {
    color: var(--color-text);
    transform: translateX(0.2rem);
  }

  @media (max-width: 56rem) {
    .home-body__layout {
      grid-template-columns: 1fr;
    }

    .home-sidebar {
      position: static;
    }
  }

  @media (max-width: 56rem) and (orientation: portrait) {
    .home-body {
      background-image:
        linear-gradient(rgb(231 231 231 / 0.6), rgb(231 231 231 / 0.6)),
        url('../../images/decorative/backgrounds/mobile_wallpaper.jpg');
      background-attachment: scroll;
    }
  }
</style>

<script>
  const rssButton = document.querySelector<HTMLAnchorElement>('[data-rss-copy]');
  const rssLabel = rssButton?.querySelector<HTMLElement>('[data-rss-label]');

  if (rssButton && rssLabel) {
    let resetTimer: number | undefined;

    rssButton.addEventListener('click', async (event) => {
      event.preventDefault();

      try {
        await navigator.clipboard.writeText(rssButton.href);

        rssLabel.textContent = '已複製';
        rssButton.classList.add('is-copied');
        rssButton.setAttribute('aria-label', '已複製 RSS 連結');
      } catch {
        rssLabel.textContent = '複製失敗';
        rssButton.classList.remove('is-copied');
        rssButton.setAttribute('aria-label', '複製 RSS 連結');
      }

      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        rssLabel.textContent = 'RSS';
        rssButton.classList.remove('is-copied');
        rssButton.setAttribute('aria-label', '複製 RSS 連結');
      }, 1800);
    });
  }

  const emailButton = document.querySelector<HTMLButtonElement>('[data-email-copy]');
  const emailLabel = emailButton?.querySelector<HTMLElement>('[data-email-label]');

  if (emailButton && emailLabel) {
    const email = emailButton.dataset.email ?? '';
    let emailResetTimer: number | undefined;

    emailButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);

        emailLabel.textContent = '已複製';
        emailButton.classList.add('is-copied');
        emailButton.setAttribute('aria-label', '已複製 PR1TEA@icloud.com');
      } catch {
        emailLabel.textContent = '複製失敗';
        emailButton.classList.remove('is-copied');
        emailButton.setAttribute('aria-label', '複製 PR1TEA@icloud.com');
      }

      window.clearTimeout(emailResetTimer);
      emailResetTimer = window.setTimeout(() => {
        emailLabel.textContent = email;
        emailButton.classList.remove('is-copied');
        emailButton.setAttribute('aria-label', '複製 PR1TEA@icloud.com');
      }, 1800);
    });
  }
</script>
